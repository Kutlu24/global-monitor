---
// English bilateral tension pair at /tension/{slug}/ - the other seven
// languages live under /{lang}/tension/{slug}/.
import TensionPair from "../../views/TensionPair.astro";
import { getBlocs } from "../../lib/data";
import { getTensionPair } from "../../lib/tension";
import { PAIRS } from "../../lib/pairs";

export async function getStaticPaths() {
  const blocs = await getBlocs();
  const blocIds = new Set(blocs.map((b) => b.bloc_id));
  return Promise.all(
    PAIRS.filter((p) => blocIds.has(p.a) && blocIds.has(p.b)).map(async (pair) => {
      await getTensionPair(pair.a, pair.b);
      return { params: { pair: pair.slug }, props: { pair } };
    })
  );
}

const { pair } = Astro.props as { pair: (typeof PAIRS)[number] };
---

<TensionPair lang="en" pair={pair} />
