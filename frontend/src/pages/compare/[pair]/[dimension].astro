---
// English dimension-of-compare page at /compare/{slug}/{dim}/ - the other
// seven languages live under /{lang}/compare/{slug}/{dim}/.
import CompareDimension from "../../../views/CompareDimension.astro";
import { getComparePair } from "../../../lib/data";
import { PAIRS } from "../../../lib/pairs";
import { DIMENSIONS, type Dimension } from "../../../lib/metrics";

export async function getStaticPaths() {
  const paths = [];
  for (const pair of PAIRS) {
    await getComparePair(pair.a, pair.b);
    for (const dimension of DIMENSIONS) {
      paths.push({ params: { pair: pair.slug, dimension }, props: { pair, dimension } });
    }
  }
  return paths;
}

const { pair, dimension } = Astro.props as { pair: (typeof PAIRS)[number]; dimension: Dimension };
---

<CompareDimension lang="en" pair={pair} dimension={dimension} />
