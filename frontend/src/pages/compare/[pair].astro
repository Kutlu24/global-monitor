---
// English compare overview at /compare/{slug}/ - the other seven languages
// live under /{lang}/compare/{slug}/.
import Compare from "../../views/Compare.astro";
import { getComparePair } from "../../lib/data";
import { PAIRS } from "../../lib/pairs";

export async function getStaticPaths() {
  return Promise.all(
    PAIRS.map(async (pair) => {
      const data = await getComparePair(pair.a, pair.b);
      return { params: { pair: pair.slug }, props: { pair } };
    })
  );
}

const { pair } = Astro.props as { pair: (typeof PAIRS)[number] };
---

<Compare lang="en" pair={pair} />
