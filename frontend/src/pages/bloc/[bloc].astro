---
// English bloc profile at /bloc/{slug}/ - the other seven languages live
// under /{lang}/bloc/{slug}/ (see src/pages/[lang]/bloc/[bloc].astro).
import Bloc from "../../views/Bloc.astro";
import { getBlocs } from "../../lib/data";

export async function getStaticPaths() {
  const blocs = await getBlocs();
  return blocs.map((bloc) => ({ params: { bloc: bloc.slug }, props: { blocId: bloc.bloc_id } }));
}

const { blocId } = Astro.props as { blocId: string };
---

<Bloc lang="en" blocId={blocId} />
