---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorldMap from "../../components/WorldMap";
import { getBlocs } from "../../lib/data";
import { DIMENSIONS, DIMENSION_LABELS, DIMENSION_METRICS, type Dimension } from "../../lib/metrics";
import { blocColor } from "../../lib/colors";
import { datasetSchema } from "../../lib/schema";

export async function getStaticPaths() {
  const compareBlocIds = ["brics", "eu", "us", "usmca"];
  const blocs = (await getBlocs()).filter((b) => compareBlocIds.includes(b.bloc_id));
  return DIMENSIONS.map((dimension) => ({ params: { dimension }, props: { dimension, blocs } }));
}

const { dimension, blocs } = Astro.props as { dimension: Dimension; blocs: Awaited<ReturnType<typeof import("../../lib/data").getBlocs>> };
const metrics = DIMENSION_METRICS[dimension];
const description = `${DIMENSION_LABELS[dimension]} data for BRICS+, the EU, the US, and USMCA, side by side.`;
const schema = datasetSchema({
  name: `${DIMENSION_LABELS[dimension]} — all blocs`,
  description,
  url: new URL(`/dimension/${dimension}/`, Astro.site).toString(),
  apiPath: "/api/blocs",
});
---
<BaseLayout title={`${DIMENSION_LABELS[dimension]} — all blocs`} description={description} structuredData={schema}>
  <a href="/" class="gm-back-link">&larr; Global Monitor</a>
  <p class="gm-hero-eyebrow">Cross-bloc view</p>
  <h1>{DIMENSION_LABELS[dimension]} — all blocs</h1>

  <ul class="gm-link-list">
    {DIMENSIONS.filter((d) => d !== dimension).map((d) => (
      <li><a href={`/dimension/${d}/`}>{DIMENSION_LABELS[d]}</a></li>
    ))}
  </ul>

  <div class="gm-viz-block">
    <WorldMap
      client:visible
      highlights={blocs.map((bloc) => ({
        iso3: bloc.members ?? [],
        color: blocColor(bloc.bloc_id).dark,
        label: bloc.name,
      }))}
    />
  </div>

  <table>
      <thead>
        <tr>
          <th>Metric</th>
          {blocs.map((bloc) => <th>{bloc.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {metrics.map((m) => (
          <tr>
            <td>{m.label}</td>
            {blocs.map((bloc) => {
              const agg = bloc.aggregates[m.metric_id];
              return <td>{agg?.value != null ? `${m.format(agg.value)} (${agg.period})` : "N/A"}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>

  {dimension === "social" && (
    <p style="font-size: 0.85rem; color: var(--ink-muted); max-width: 68ch;">
      "(% gross)" on secondary school enrollment is the World Bank's own Gross Enrollment Ratio -
      total secondary enrollment of any age, divided by the population of the official
      secondary-school age group. It can genuinely exceed 100% (over-age, under-age, and repeating
      students all count) - not an error in this data.
    </p>
  )}
</BaseLayout>
