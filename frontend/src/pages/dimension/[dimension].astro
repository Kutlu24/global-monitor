---
// English cross-bloc dimension page at /dimension/{dim}/ - the other seven
// languages live under /{lang}/dimension/{dim}/.
import Dimension from "../../views/Dimension.astro";
import { DIMENSIONS, type Dimension as Dim } from "../../lib/metrics";

export function getStaticPaths() {
  return DIMENSIONS.map((dimension) => ({ params: { dimension } }));
}

const { dimension } = Astro.params as { dimension: Dim };
---

<Dimension lang="en" dimension={dimension} />
