---
// Localized Current Tension index under /{lang}/tension/. English lives at
// the URL root.
import TensionIndex from "../../../views/TensionIndex.astro";
import { NON_DEFAULT_LANGS, type Lang } from "../../../i18n";

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<TensionIndex lang={lang} />
