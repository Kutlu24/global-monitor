---
// Localized major-economies index under /{lang}/countries/. English lives
// at the URL root.
import Countries from "../../../views/Countries.astro";
import { NON_DEFAULT_LANGS, type Lang } from "../../../i18n";

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Countries lang={lang} />
