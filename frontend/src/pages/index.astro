---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBlocs } from "../lib/data";
import { PAIRS } from "../lib/pairs";
import { DIMENSIONS, DIMENSION_LABELS } from "../lib/metrics";

const blocs = await getBlocs();

function formatUsd(value: number | null): string {
  if (value === null) return "—";
  return `$${(value / 1e12).toFixed(2)}T`;
}
function formatPeople(value: number | null): string {
  if (value === null) return "—";
  return `${(value / 1e6).toFixed(0)}M`;
}
---
<BaseLayout title="Home" description="Global Monitor compares BRICS, the EU, the US, and USMCA across economic, trade, social, and military data.">
  <main>
    <h1>Global Monitor</h1>
    <p>Bloc-vs-bloc comparison — economic, trade, social, and military data, kept in sync with official sources.</p>
    <p>Looking for individual countries instead? See <a href="/countries/">Major Economies</a> — the top 20 advanced economies, compared one by one.</p>
    <table>
      <thead>
        <tr><th>Bloc</th><th>GDP</th><th>Population</th><th>Members with data</th></tr>
      </thead>
      <tbody>
        {blocs.map((bloc) => (
          <tr>
            <td><a href={`/bloc/${bloc.slug}/`}>{bloc.name}</a></td>
            <td>{formatUsd(bloc.aggregates.gdp_current_usd?.value ?? null)}</td>
            <td>{formatPeople(bloc.aggregates.population_total?.value ?? null)}</td>
            <td>{bloc.aggregates.gdp_current_usd?.member_count ?? 0}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Compare two blocs</h2>
    <ul>
      {PAIRS.map((p) => <li><a href={`/compare/${p.slug}/`}>{p.a.toUpperCase()} vs {p.b.toUpperCase()}</a></li>)}
    </ul>

    <h2>By dimension</h2>
    <ul>
      {DIMENSIONS.map((d) => <li><a href={`/dimension/${d}/`}>{DIMENSION_LABELS[d]}</a></li>)}
    </ul>
  </main>
</BaseLayout>
