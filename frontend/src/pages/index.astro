---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBlocs } from "../lib/data";
import { PAIRS } from "../lib/pairs";
import { DIMENSIONS, DIMENSION_LABELS } from "../lib/metrics";
import { blocColor } from "../lib/colors";
import { getLastUpdated } from "../lib/sitemap";

const blocs = (await getBlocs()).filter((b) => b.bloc_id !== "brics5");
const lastUpdated = await getLastUpdated();
const lastUpdatedLabel = new Date(lastUpdated).toLocaleDateString("en-US", {
  year: "numeric", month: "short", day: "numeric",
});

function formatUsd(value: number | null): string {
  if (value === null) return "—";
  return `$${(value / 1e12).toFixed(2)}T`;
}
function formatPeople(value: number | null): string {
  if (value === null) return "—";
  return `${(value / 1e6).toFixed(0)}M`;
}
---
<BaseLayout title="Home" description="Global Monitor compares BRICS, the EU, the US, and USMCA across economic, trade, social, and military data.">
  <section class="gm-hero">
    <p class="gm-live-badge"><span class="gm-live-dot" aria-hidden="true"></span>Data updated {lastUpdatedLabel}</p>
    <p class="gm-hero-eyebrow">Bloc-vs-bloc comparison</p>
    <h1>How the world's major blocs stack up</h1>
    <p class="gm-lede">
      Economic, trade, social, and military data for BRICS+, the EU, the US, and USMCA —
      pulled from the World Bank, UN Comtrade, UNDP, and SIPRI and kept in sync automatically,
      not a one-off snapshot.
    </p>
    <p>
      Looking for individual countries instead? See <a href="/countries/">Major Economies</a> —
      the world's top 20 advanced economies, compared one by one. Or try the
      <a href="/risk/">Global Risk Simulator</a> — how 19 countries rank under six different
      global-crisis scenarios.
    </p>
  </section>

  <div class="gm-grid">
    {blocs.map((bloc) => {
      const gdp = bloc.aggregates.gdp_current_usd;
      const pop = bloc.aggregates.population_total;
      return (
        <a href={`/bloc/${bloc.slug}/`} class="gm-card">
          <span class="gm-card-eyebrow">
            <span class="gm-swatch" style={{ background: blocColor(bloc.bloc_id).dark }} />
            {gdp?.member_count ?? 0} member{(gdp?.member_count ?? 0) === 1 ? "" : "s"} with data
          </span>
          <h3>{bloc.name}</h3>
          <div class="gm-card-stats">
            <div>
              <div class="gm-stat-value">{formatUsd(gdp?.value ?? null)}</div>
              <div class="gm-stat-label">GDP{gdp ? ` (${gdp.period})` : ""}</div>
            </div>
            <div>
              <div class="gm-stat-value">{formatPeople(pop?.value ?? null)}</div>
              <div class="gm-stat-label">Population{pop ? ` (${pop.period})` : ""}</div>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <h2>Compare two blocs</h2>
  <ul class="gm-link-list">
    {PAIRS.map((p) => <li><a href={`/compare/${p.slug}/`}>{p.a.toUpperCase()} vs {p.b.toUpperCase()}</a></li>)}
  </ul>

  <h2>By dimension</h2>
  <ul class="gm-link-list">
    {DIMENSIONS.map((d) => <li><a href={`/dimension/${d}/`}>{DIMENSION_LABELS[d]}</a></li>)}
  </ul>

  <h2>Global Risk Simulator</h2>
  <p>
    A separate module: ranks 19 countries by resilience under six global-crisis scenarios.
    <a href="/risk/">See all scenarios &rarr;</a>
  </p>
</BaseLayout>
