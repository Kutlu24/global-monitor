---
// English risk scenario page at /risk/{slug}/ - the other seven languages
// live under /{lang}/risk/{slug}/.
import RiskScenario from "../../views/RiskScenario.astro";
import { getRiskScenarios } from "../../lib/data";

export async function getStaticPaths() {
  const scenarios = await getRiskScenarios();
  return scenarios.map((s) => ({ params: { scenario: s.slug } }));
}

const { scenario: slug } = Astro.params as { scenario: string };
---

<RiskScenario lang="en" slug={slug} />
