---
// English country page at /country/{iso3}/ - the other seven languages live
// under /{lang}/country/{iso3}/.
import Country from "../../views/Country.astro";
import { getCountries } from "../../lib/data";

export async function getStaticPaths() {
  const countries = await getCountries();
  return countries.map((c) => ({ params: { iso3: c.iso3.toLowerCase() }, props: { iso3: c.iso3 } }));
}

const { iso3 } = Astro.props as { iso3: string };
---

<Country lang="en" iso3={iso3} />
