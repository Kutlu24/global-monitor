---
import "../styles/global.css";
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
// Emitted as <link rel=preload> below. The @font-face rules themselves come
// from the fontsource CSS imports above (Vite resolves and hashes those
// assets for us); importing the same woff2 with ?url here just gets us the
// final hashed path so the latin subset - the only one any page's glyphs
// will match, per each @font-face's unicode-range - can start downloading in
// parallel with the CSS instead of after it. Self-hosted per Grafana's own
// rule: never Google Fonts, because the OpenType features this site's
// numerals depend on (tabular-nums) are exactly what the CDN builds drop.
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

import { getBlocs, getRiskScenarios } from "../lib/data";
import { PAIRS } from "../lib/pairs";
import { DIMENSIONS, DIMENSION_METRIC_COUNT } from "../lib/metrics";
import {
  WORLDORA_URL, INTELLIGENCE_URL, HUB_SITE_URL, HUB_NAME, worldoraSectionFor, worldoraSectionUrl,
  intelligenceAskUrl, intelligenceBriefingUrl,
} from "../lib/network";
import { createI18n, DEFAULT_LANG, LANGS, NATIVE_NAME, alternatePath, localizePath, stripLang, type Lang } from "../i18n";

// schema.org/Dataset JSON-LD - pass `structuredData` (a plain object) from
// any page that represents real data (bloc/compare/dimension/country
// pages); pages that don't (the homepage) just omit it. Every page is
// self-canonical per language - compare/bloc pages are genuinely different
// content from each other (see synthesis.py's own per-page prompts), so
// there's no "duplicate" page needing a canonical pointing elsewhere; the
// hreflang cluster below is what ties the eight language versions of the
// SAME page together.
interface Props {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown>;
  /** Serving language of THIS page. English lives at the URL root; the
   *  other seven are served under /{lang}/ and generated by the [lang]
   *  route trees. Defaults to "en" so a page that has not been converted
   *  yet keeps rendering exactly as before. */
  lang?: Lang;
}
const { title, description = "", structuredData, lang = DEFAULT_LANG } = Astro.props;
const { t, rtl, dimensionLabel } = createI18n(lang);

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(href));
const home = localizePath("/", lang);
const L = (p: string) => localizePath(p, lang);

// Full site map in the sidebar, not just three top-level links - the site
// has 76 pages reachable only through in-content links. User feedback
// (2026-09-27): "web arayüzü gezilebilir bulmadım" (couldn't find the site
// navigable).
//
// The nav is deliberately flat - no <details> disclosure, no JS accordion.
// Flat is also the right call: the whole list is 17 items (4 blocs + 6
// pairs + 4 dimensions + 3 modules), which is a short enough list that
// collapsing the two navigational groups behind a click would cost more
// discoverability than it bought back.
const blocs = await getBlocs(lang);
const blocById = Object.fromEntries(blocs.map((b) => [b.bloc_id, b]));
const pairName = (p: (typeof PAIRS)[number]) => `${blocById[p.a]?.name ?? p.a} vs ${blocById[p.b]?.name ?? p.b}`;

// The nav badge is the scenario count, which is now data rather than a
// hardcoded array's `.length`. data.ts memoises by path (and `?lang=` is
// part of that path), so this costs one request per language for the whole
// build, not one per page.
//
// `.catch(() => [])` on purpose, and only here: this layout is on every
// page, including ones that have nothing to do with risk, so a risk-endpoint
// failure must not fail the entire site build over a nav badge. The risk
// pages themselves call getRiskScenario()/getRiskScenarios() without a
// catch, so if the ETL hasn't run the risk module fails the build loudly
// rather than publishing an empty module.
const riskScenarios = await getRiskScenarios(lang).catch(() => []);

// Contextual cross-links to the sibling sites, derived from the page being
// read. The Worldora section label is localized; the slug never is.
// worldoraSectionFor matches on English paths, so strip any /{lang}/ prefix
// first - on /tr/tension/ it must still resolve to the defense section.
const barePath = stripLang(path);
const wSection = worldoraSectionFor(barePath);
// The section keys (net.section.defense/economy/world) match the slugs
// worldoraSectionFor returns, so the lookup is a direct interpolation.
const wSectionLabel = t(`net.section.${wSection.slug}`);
const isHome = barePath === "/";
const askQuestion = isHome ? t("net.ask.home") : t("net.ask.page", { title });

// hreflang cluster: the same page in all eight languages plus x-default
// (English). Built from the CURRENT path with the language prefix swapped,
// so it works identically on /bloc/eu/ and /tr/bloc/eu/.
const alternates = LANGS.map((l) => ({ lang: l, href: new URL(alternatePath(path, l, lang), Astro.site).toString() }));
const xDefault = new URL(alternatePath(path, DEFAULT_LANG, lang), Astro.site).toString();
---

<!doctype html>
<html lang={lang} dir={rtl ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Global Monitor</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <!-- Named head slot: the hub page injects its stage.css here so the
         WebGL slider can load its own stylesheet without polluting every
         other page's critical path. -->
    <slot name="head" />
    <!-- Sets the data-theme attribute from the OS preference before first
         paint. The light palette in global.css (`:root[data-theme="light"]`,
         contrast-measured) had no setter anywhere, so every visitor got dark
         mode regardless of their system setting. -->
    <script is:inline>
      const gmTheme = matchMedia("(prefers-color-scheme: light)");
      const gmApplyTheme = () => {
        document.documentElement.dataset.theme = gmTheme.matches ? "light" : "dark";
      };
      gmApplyTheme();
      gmTheme.addEventListener("change", gmApplyTheme);
    </script>
    <!-- Runs before first paint, so the reveal transition below is armed
         without a flash of already-visible content - and is NOT armed at
         all when the reader has asked for reduced motion, which is also what
         makes the no-JS case safe: the hidden state is gated behind this
         class, so with JS off the content is simply visible. -->
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("gm-motion");
      }
    </script>
  </head>
  <body>
    <a href="#main" class="gm-skip-link">{t("a11y.skip")}</a>
    <div class="gm-shell">
      <input type="checkbox" id="gm-nav-toggle" class="gm-nav-toggle-checkbox" />
      <div class="gm-topbar-mobile">
        <a href={home} class="gm-logo">
          <span class="gm-logo__mark" aria-hidden="true"></span>
          <span>Global Monitor</span>
        </a>
        <label for="gm-nav-toggle" class="gm-nav-toggle-label">{t("a11y.menu")}</label>
      </div>
      <div class="gm-layout">
        <nav class="gm-sidebar" aria-label={t("a11y.mainNav")}>
          <a href={home} class="gm-logo gm-sidebar-brand">
            <span class="gm-logo__mark" aria-hidden="true"></span>
            <span>
              Global Monitor
              <span class="gm-logo__sub">{t("site.sub")}</span>
            </span>
          </a>

          <div class="gm-nav-group">
            <div class="gm-nav-heading">{t("nav.blocs")}</div>
            {blocs.map((b) => (
              <a
                href={L(`/bloc/${b.slug}/`)}
                class="gm-nav-item"
                aria-current={isActive(L(`/bloc/${b.slug}/`)) ? "page" : undefined}
              >
                <span class="gm-swatch" style={{ background: `var(--bloc-${b.bloc_id})` }} aria-hidden="true"></span>
                <span class="gm-nav-item__label">{b.name}</span>
              </a>
            ))}
          </div>

          <div class="gm-nav-group">
            <div class="gm-nav-heading">{t("nav.compare")}</div>
            {PAIRS.map((p) => (
              <a
                href={L(`/compare/${p.slug}/`)}
                class:list={["gm-nav-item", p.featured && "gm-nav-item--featured"]}
                aria-current={isActive(L(`/compare/${p.slug}/`)) ? "page" : undefined}
              >
                <span class="gm-nav-item__label">{pairName(p)}</span>
                {p.featured && <span class="gm-nav-item__flag">{t("nav.primary")}</span>}
              </a>
            ))}
          </div>

          <div class="gm-nav-group">
            <div class="gm-nav-heading">{t("nav.dimensions")}</div>
            {DIMENSIONS.map((d) => (
              <a
                href={L(`/dimension/${d}/`)}
                class="gm-nav-item"
                aria-current={isActive(L(`/dimension/${d}/`)) ? "page" : undefined}
              >
                <span class="gm-nav-item__label">{dimensionLabel(d)}</span>
                <span class="gm-nav-item__count">{DIMENSION_METRIC_COUNT[d]}</span>
              </a>
            ))}
          </div>

          <div class="gm-nav-group">
            <div class="gm-nav-heading">{t("nav.modules")}</div>
            <a
              href={L("/countries/")}
              class="gm-nav-item"
              aria-current={isActive(L("/countries/")) || isActive(L("/country/")) ? "page" : undefined}
            >
              <span class="gm-nav-item__label">{t("nav.majorEconomies")}</span>
            </a>
            <a href={L("/risk/")} class="gm-nav-item" aria-current={isActive(L("/risk/")) ? "page" : undefined}>
              <span class="gm-nav-item__label">{t("nav.risk")}</span>
              {riskScenarios.length > 0 && (
                <span class="gm-nav-item__count">{riskScenarios.length}</span>
              )}
            </a>
            <a href={L("/tension/")} class="gm-nav-item" aria-current={isActive(L("/tension/")) ? "page" : undefined}>
              <span class="gm-nav-item__label">{t("nav.tension")}</span>
            </a>
            <a href={L("/hub/")} class="gm-nav-item" aria-current={isActive(L("/hub/")) ? "page" : undefined}>
              <span class="gm-nav-item__label">{t("nav.hub")}</span>
            </a>
          </div>

          <div class="gm-nav-group">
            <div class="gm-nav-heading">{t("nav.related")}</div>
            <a href={`${WORLDORA_URL}/`} class="gm-nav-item" rel="noopener" target="_blank">
              <span class="gm-nav-item__label">{t("nav.worldoraNews")}</span>
            </a>
            <a href={INTELLIGENCE_URL} class="gm-nav-item" rel="noopener" target="_blank">
              <span class="gm-nav-item__label">{t("nav.worldoraIntel")}</span>
            </a>
          </div>
        </nav>

        <div class="gm-main-col">
          <main class="gm-container" id="main">
            <slot />
            <aside class="gm-grid" aria-label={t("net.heading")} style="margin-top: var(--space-7, 3rem);">
              <a class="gm-card" href={worldoraSectionUrl(wSection.slug)} rel="noopener" target="_blank">
                <span class="gm-card-eyebrow">Worldora</span>
                <h3>{t("net.newsTitle", { label: wSectionLabel })}</h3>
                <p>{t("net.newsDesc")}</p>
              </a>
              <a class="gm-card" href={intelligenceAskUrl(askQuestion)} rel="noopener" target="_blank">
                <span class="gm-card-eyebrow">Worldora Intelligence</span>
                <h3>{t("net.analyseTitle")}</h3>
                <p>{t("net.analyseDesc")}</p>
              </a>
              <a class="gm-card" href={intelligenceBriefingUrl} rel="noopener" target="_blank">
                <span class="gm-card-eyebrow">Worldora Intelligence</span>
                <h3>{t("net.briefingTitle")}</h3>
                <p>{t("net.briefingDesc")}</p>
              </a>
            </aside>
          </main>
          <footer class="gm-footer">
            <div class="gm-container">
              <div class="gm-footer-grid">
                <div>
                  <a href={home} class="gm-logo">
                    <span class="gm-logo__mark" aria-hidden="true"></span>
                    <span>Global Monitor</span>
                  </a>
                  <p style="font-size: var(--fs-sm); margin-top: var(--space-3); max-width: 34ch;">
                    {t("footer.tagline")}
                  </p>
                </div>
                <div>
                  <p class="gm-nav-heading" style="padding: 0;">{t("footer.sources")}</p>
                  <p style="font-size: var(--fs-sm); max-width: 32ch;">
                    {t("footer.sourcesNote")}
                  </p>
                </div>
                <div>
                  <p class="gm-nav-heading" style="padding: 0;">{t("footer.alsoHere")}</p>
                  <p style="font-size: var(--fs-sm); max-width: 32ch;">
                    <a href={L("/countries/")}>{t("nav.majorEconomies")}</a> · <a href={L("/risk/")}>{t("nav.risk")}</a> ·
                    <a href={L("/tension/")}>{t("nav.tension")}</a> · <a href={L("/hub/")}>{t("nav.hub")}</a>
                  </p>
                  <p class="gm-nav-heading" style="padding: 0; margin-top: var(--space-3);">{t("footer.worldoraNetwork")}</p>
                  <p style="font-size: var(--fs-sm); max-width: 32ch;">
                    <a href={`${WORLDORA_URL}/`} rel="noopener">Worldora</a> ·
                    <a href={INTELLIGENCE_URL} rel="noopener">Worldora Intelligence</a>
                  </p>
                  <p style="font-size: var(--fs-sm); max-width: 32ch; margin-top: var(--space-3);">
                    {t("footer.by")} <a href={HUB_SITE_URL} rel="noopener">{HUB_NAME}</a>
                  </p>
                  <p class="gm-nav-heading" style="padding: 0; margin-top: var(--space-4);">{t("lang.label")}</p>
                  <nav class="gm-lang-switch" aria-label={t("lang.label")}>
                    {LANGS.map((l) => (
                      <a
                        href={alternatePath(path, l, lang)}
                        hreflang={l}
                        lang={l}
                        class="gm-lang-switch__item"
                        aria-current={l === lang ? "true" : undefined}
                      >
                        {NATIVE_NAME[l]}
                      </a>
                    ))}
                  </nav>
                </div>
              </div>
            </div>
          </footer>
        </div>
      </div>
    </div>

    <script is:inline>
      // Scroll reveal. Two rules, both load-bearing:
      //  1. The hidden state lives behind the .gm-motion class the <head>
      //     script adds, so with JS off (or reduced motion on) nothing is
      //     ever hidden - an SEO-first site must never gate content behind an
      //     observer that might not fire.
      //  2. Only elements that actually intersect get revealed; everything
      //     else is revealed unconditionally on a timer, so a broken
      //     observer can only mean "no animation", never "invisible text".
      (function () {
        var targets = document.querySelectorAll("[data-reveal]");
        if (!targets.length) return;
        function showAll() {
          targets.forEach(function (el) { el.classList.add("is-visible"); });
        }
        if (!document.documentElement.classList.contains("gm-motion") || !("IntersectionObserver" in window)) {
          showAll();
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var i = Array.prototype.indexOf.call(targets, entry.target);
              entry.target.style.transitionDelay = Math.min(i % 6, 5) * 45 + "ms";
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -6% 0px", threshold: 0.04 }
        );
        targets.forEach(function (el) { io.observe(el); });
        // Backstop.
        setTimeout(showAll, 2500);
      })();
    </script>
  </body>
</html>

<style>
  /* Language switcher: a wrapping row of native-name links in the footer.
     Native names are never translated (see i18n/config.ts), so no label
     lookup is needed here. The current language is marked with aria-current
     and a visible accent underline. */
  .gm-lang-switch {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-size: var(--fs-sm);
    max-width: 32ch;
  }
  .gm-lang-switch__item {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .gm-lang-switch__item:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .gm-lang-switch__item[aria-current="true"] {
    color: var(--accent);
    font-weight: 600;
    border-bottom: 2px solid var(--accent);
  }
</style>
