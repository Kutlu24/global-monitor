---
import "../styles/global.css";

// schema.org/Dataset JSON-LD - pass `structuredData` (a plain object) from
// any page that represents real data (bloc/compare/dimension/country
// pages); pages that don't (the homepage) just omit it. Every page is
// self-canonical (see the <link> below) - compare/bloc pages are
// genuinely different content from each other (see synthesis.py's own
// per-page prompts), so there's no "duplicate" page needing a canonical
// pointing elsewhere, per the project plan's SEO section.
interface Props {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown>;
}
const { title, description = "", structuredData } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Global Monitor</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <header class="gm-header">
      <div class="gm-container gm-header-inner">
        <a href="/" class="gm-logo">Global Monitor</a>
        <nav>
          <ul class="gm-nav">
            <li><a href="/">Blocs</a></li>
            <li><a href="/dimension/economic/">Dimensions</a></li>
            <li><a href="/countries/">Major Economies</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <div class="gm-container">
      <main>
        <slot />
      </main>
    </div>
    <footer class="gm-footer">
      <div class="gm-container">
        Data from the World Bank, UN Comtrade, UNDP, and SIPRI, kept in sync automatically. Not affiliated with any of these organizations.
      </div>
    </footer>
  </body>
</html>
