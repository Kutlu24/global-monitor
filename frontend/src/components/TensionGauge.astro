---
import { TENSION_DIVERGING } from "../lib/colors";
import { createI18n, type Lang } from "../i18n";

interface Props {
  value: number | null;
  label?: string;
  lang?: Lang;
}
const { value, label, lang = "en" } = Astro.props;
const { t } = createI18n(lang);
const DOMAIN = 10; // Goldstein scale: -10 (most conflictual) .. +10 (most cooperative)
const clamped = value == null ? 0 : Math.max(-DOMAIN, Math.min(DOMAIN, value));
const halfPct = (Math.abs(clamped) / DOMAIN) * 50; // 0..50, distance from center
const isPositive = clamped >= 0;
const color = isPositive ? TENSION_DIVERGING.cooperation.dark : TENSION_DIVERGING.conflict.dark;

// A spoken form of the number, so the bar is not the only way to read the
// value - and so the zero case says "neutral" instead of just showing 0.00.
const magnitude = Math.abs(clamped);
const verdictKey =
  magnitude < 0.5 ? "tension.verdict.neutral" : magnitude < 3 ? "tension.verdict.mildly" : magnitude < 6.5 ? "tension.verdict.clearly" : "tension.verdict.strongly";
const poleKey = isPositive ? "tension.pole.cooperative" : "tension.pole.conflictual";
const ariaLabel =
  value == null
    ? t("tension.aria.noData")
    : t("tension.aria.score", {
        value: clamped.toFixed(2),
        verdict: t(verdictKey),
        pole: t(poleKey),
      });
---

<!-- A diverging bar, not a sequential one - the dataviz skill's fixed
     blue<->red diverging pair with a neutral zero, since Goldstein is a
     genuinely bipolar scale (a real negative pole, not "low magnitude").

     Markup + classes are shared verbatim with the inline Gauge inside
     CountryTensionQuery.tsx; the styling itself lives in global.css, so the
     two cannot drift apart. -->
<div class="gm-tension" role="meter" aria-label={ariaLabel} aria-valuenow={value ?? undefined} aria-valuemin={-DOMAIN} aria-valuemax={DOMAIN}>
  {label && <div class="gm-tension__label">{label}</div>}

  <div class="gm-tension__track">
    <span class="gm-tension__center" aria-hidden="true"></span>
    {[-10, -5, 5, 10].map((tick) => (
      <span class="gm-tension__tick" style={{ left: `${((tick + DOMAIN) / (2 * DOMAIN)) * 100}%` }} aria-hidden="true"></span>
    ))}
    {value != null && (
      <div
        class="gm-tension__fill"
        style={{
          left: isPositive ? "50%" : `${50 - halfPct}%`,
          /* A hairline minimum so a genuine score of exactly 0.0 is still
             visible as "measured, and it was zero" rather than as missing. */
          width: `${Math.max(halfPct, 0.6)}%`,
          background: color,
        }}
      />
    )}
  </div>

  <div class="gm-tension__scale">
    <span>&minus;10</span>
    <span class="gm-tension__poles" aria-hidden="true">
      <span>{t("tension.pole.conflict")}</span>
      <span>{t("tension.pole.cooperation")}</span>
    </span>
    <span>+10</span>
  </div>
  <div class="gm-tension__readout">
    <span class="gm-tension__value">{value != null ? (clamped > 0 ? "+" : "") + clamped.toFixed(2) : t("table.na")}</span>
  </div>
</div>
