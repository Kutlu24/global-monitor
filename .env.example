# Copy to .env for local dev - these are the UNPREFIXED names config.py's
# Settings actually reads (matches its field names directly). In
# home-server-infra's docker-compose.yml these get set from prefixed
# `GLOBAL_MONITOR_*` host variables (see that repo's own .env.example) -
# the prefix lives at the compose level to disambiguate between apps,
# never inside this app's own env.

# Comparison-text generation (Milestone 4) - GLM primary, Ollama fallback.
SYNTHESIS_PROVIDER=glm
GLM_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# UN Comtrade / WTO (Milestone 2) - optional, both work key-less at a lower rate limit.
COMTRADE_API_KEY=
WTO_API_KEY=

# Gates POST /api/admin/rebuild.
ADMIN_TOKEN=

# Real domain, once purchased (Milestone 5) - feeds Astro's canonical URLs
# and the SEO sitemap/schema.org markup. Empty is fine for local dev.
SITE_URL=

DATA_DIR=./backend/data
PORT=7860
